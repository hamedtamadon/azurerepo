{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "df-adfProject"
		},
		"linekdS_onPerm_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'linekdS_onPerm'"
		},
		"ls_deltalake_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_deltalake'"
		},
		"linekdS_onPerm_properties_typeProperties_host": {
			"type": "string",
			"defaultValue": "\\\\192.168.0.246\\ADF_Project"
		},
		"linekdS_onPerm_properties_typeProperties_userId": {
			"type": "string",
			"defaultValue": "lt-176\\hamed tamadon"
		},
		"ls_deltalake_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://storageadeltalake.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "df-adfProject_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_deltalake_accountKey": {
						"value": "[parameters('ls_deltalake_accountKey')]"
					},
					"linekdS_onPerm_password": {
						"value": "[parameters('linekdS_onPerm_password')]"
					},
					"ls_deltalake_properties_typeProperties_url": {
						"value": "[parameters('ls_deltalake_properties_typeProperties_url')]"
					},
					"linekdS_onPerm_properties_typeProperties_host": {
						"value": "[parameters('linekdS_onPerm_properties_typeProperties_host')]"
					},
					"linekdS_onPerm_properties_typeProperties_userId": {
						"value": "[parameters('linekdS_onPerm_properties_typeProperties_userId')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}